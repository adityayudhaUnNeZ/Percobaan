{
  "name": "minkes-radio",
  "version": "1.0.0",
  "private": true,
  "description": "Minkes Radio web (Express + Tailwind)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -c ../tailwind.config.js -i ../frontend/src/output.source.css -o ../frontend/assets/styles/styles.css",
    "watch:css": "tailwindcss -c ../tailwind.config.js -i ../frontend/src/output.source.css -o ../frontend/assets/styles/styles.css --watch",
    "dev": "concurrently -k \"npm:watch:css\" \"nodemon server.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
